{
  "name": "teashop",
  "version": "1.0.0",
  "description": "融合玩法（红线 × 守宅 × 修仙家族）的逻辑核心与数值模拟器",
  "scripts": {
    "test": "vitest run --dir test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sim.json",
    "sim": "tsx src/sim/cli.ts",
    "build:web": "node scripts/build-web.mjs",
    "build:loop": "node scripts/build-loop-core.mjs",
    "sync:draw": "node scripts/sync-shared-draw.mjs",
    "test:proto": "node scripts/proto-tests/run-all.cjs",
    "balance:night": "node scripts/proto-tests/night-balance.cjs",
    "balance:loop": "tsx scripts/loop-night-balance.ts",
    "sim:trade": "tsx scripts/loop-trade-sim.ts",
    "balance:haunt": "node scripts/proto-tests/haunt-balance.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bk8nyr28rn-sys/teashop.git"
  },
  "bugs": {
    "url": "https://github.com/bk8nyr28rn-sys/teashop/issues"
  },
  "homepage": "https://github.com/bk8nyr28rn-sys/teashop#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "private": true
}
