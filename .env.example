# Copy to .env.local and fill in. Never commit real values.
# Production values and where they come from: docs/DEPLOY.md

# PostgreSQL connection string (Neon pooled URL in production; local Postgres for dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qijian
# Optional direct connection used for migrations (Neon sets this automatically).
# DATABASE_URL_UNPOOLED=

# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (https:// in production).
BETTER_AUTH_URL=http://localhost:3000

# Email — required in production. In dev, codes are printed to the server log when unset.
RESEND_API_KEY=
# Use a neutral sender name; inbox previews are visible to others.
EMAIL_FROM="Account <no-reply@example.com>"

# Closed beta: set to false to make joining invite-only.
APPLICATIONS_OPEN=true

# Auth rate limiting is always on in production; set to "on" to try it locally.
# RATE_LIMIT=on

# Preview deploys only: run migrations when previews have their own DB branch.
# MIGRATE_ON_PREVIEW=false

# Paid Q&A (optional). Without a key: fake payments in dev, Q&A hidden in production.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Protects /api/cron/expire-questions (Vercel Cron sends it as a Bearer token).
# CRON_SECRET=
