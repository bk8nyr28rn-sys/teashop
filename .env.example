# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL connection string (Neon in production; local Postgres for dev).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qijian

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app.
BETTER_AUTH_URL=http://localhost:3000

# Email (optional in dev — codes are printed to the server log when unset).
RESEND_API_KEY=
# Use a neutral sender name; inbox previews are visible to others.
EMAIL_FROM="Account <no-reply@example.com>"
